# ==============================================================================
# Book Moar START — Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to .env for local development: cp .env.example .env
# 2. In production (Netlify), configure these variables in the Netlify Dashboard:
#    Site Configuration > Environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (Required)
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string. In production, use your Neon pooled endpoint.
DATABASE_URL="postgresql://user:password@ep-example-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION (Required in Production)
# ------------------------------------------------------------------------------
# Strong 32+ character random secret used to sign JWT owner session cookies.
# Generate one via terminal: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-character-secret-in-production"

# ------------------------------------------------------------------------------
# 3. APPLICATION ORIGIN (Required in Production)
# ------------------------------------------------------------------------------
# The canonical public URL of this Book Moar deployment.
# Used for TwiML callback URLs and webhook signature validation.
# Development: http://localhost:3000
# Production:  https://app.clientdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. INTERNAL AGENCY SETUP MODE (Optional)
# ------------------------------------------------------------------------------
# Set to "true" during initial onboarding to access /services and /business.
# Set to "false" (or omit) during normal production client operation.
ENABLE_INTERNAL_SETUP="false"

# ------------------------------------------------------------------------------
# 5. TWILIO VOICE & SMS (Optional for local dev, Required for production SMS/Calls)
# ------------------------------------------------------------------------------
# Found in your Twilio Console dashboard: https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+19195550100"

# ------------------------------------------------------------------------------
# 6. FEATURE TOGGLES (Optional)
# ------------------------------------------------------------------------------
# Enable or disable automated SMS notifications sent to the owner on new leads.
TWILIO_OWNER_NOTIFICATIONS_ENABLED="true"

# Enable or disable automated missed-call recovery SMS sent to inbound callers.
TWILIO_RECOVERY_SMS_ENABLED="true"
