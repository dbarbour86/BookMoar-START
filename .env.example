# Database (Isolated Single-Client Database)
DATABASE_URL="postgresql://bookmoar:bookmoar_password@localhost:5432/bookmoar_db?schema=public"

# Authentication
# Secret key used to sign and verify owner session JWTs (Generate with `openssl rand -hex 32`)
AUTH_SECRET="dev-insecure-secret-key-change-in-production-at-least-32-chars-long"

# Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Twilio Missed-Call & SMS Notification Configuration (Optional in Dev - falls back to DevMockLogger)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_RECOVERY_SMS_ENABLED="true"
TWILIO_OWNER_NOTIFICATIONS_ENABLED="true"
